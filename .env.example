DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0

APP_ALLOWED_HOSTS=personal.neosaware.ai
APP_CSRF_TRUSTED_ORIGINS=https://personal.neosaware.ai

DB_ENGINE=postgresql
POSTGRES_DB=inversiones_personales
POSTGRES_USER=inversiones_personales
POSTGRES_PASSWORD=replace-with-a-strong-db-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# SQLite no se usa ya por defecto fuera de desarrollo.

APP_STATIC_ROOT=staticfiles
APP_MEDIA_ROOT=media
APP_MEDIA_ENCRYPTION_KEY=
BANK_ROBOT_IMPORT_TOKEN=

APP_USE_X_FORWARDED_HOST=1
APP_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
APP_SECURE_SSL_REDIRECT=1
APP_SESSION_COOKIE_SECURE=1
APP_CSRF_COOKIE_SECURE=1
APP_SESSION_COOKIE_SAMESITE=Lax
APP_CSRF_COOKIE_SAMESITE=Lax
APP_SECURE_HSTS_SECONDS=31536000
APP_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
APP_SECURE_HSTS_PRELOAD=1
APP_SECURE_REFERRER_POLICY=same-origin
APP_SECURE_CROSS_ORIGIN_OPENER_POLICY=same-origin
APP_SECURE_CROSS_ORIGIN_RESOURCE_POLICY=same-origin
APP_X_FRAME_OPTIONS=DENY
BANK_STATEMENT_MAX_FILES_PER_REQUEST=8
BANK_STATEMENT_MAX_FILE_BYTES=8388608
APP_EQUITIES_NIGHTLY_ANALYSIS_ENABLED=1
APP_EQUITIES_NIGHTLY_ANALYSIS_START_HOUR=0
APP_EQUITIES_NIGHTLY_ANALYSIS_MAX_AGE_HOURS=36
APP_EQUITIES_NIGHTLY_LLM_REFRESH_ISO_WEEKDAYS=2,4
APP_EQUITIES_SCHEDULED_OPTIMIZATION_ENABLED=1
APP_EQUITIES_SCHEDULED_OPTIMIZATION_ISO_WEEKDAYS=2,4
APP_EQUITIES_NIGHTLY_ANALYSIS_AGENT_PROVIDER=core
APP_EQUITIES_NIGHTLY_ANALYSIS_AGENT_LABEL=Analista nocturno
AI_LLM_PROVIDER=anthropic
AI_LLM_REQUEST_TIMEOUT_SECONDS=45
AI_LLM_RETRY_ATTEMPTS=4
AI_LLM_RATE_LIMIT_RETRY_SECONDS=15
AI_LLM_MONTHLY_BUDGET_USD=0

ANTHROPIC_API_KEY=
CLAUDE_DEFAULT_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=1024
CLAUDE_MONTHLY_BUDGET_USD=50.00

OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2048
OPENAI_MONTHLY_BUDGET_USD=0
